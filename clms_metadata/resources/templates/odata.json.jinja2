{
    "@odata.context": "$metadata#Products(Attributes())",
    "Name": "{{ metadata.name }}_{{ metadata.name_suffix }}",
    "EvictionDate": "9999-12-31T23:59:59.999999Z",
    "ModificationDate": "{{ metadata.modification_date }}",
    "OriginDate": "{{ metadata.origin_date }}",
    "PublicationDate": "{{ metadata.publication_date }}",
    {% if 'content_length' in metadata %}
    "ContentLength": {{ metadata.content_length }},
    {% endif %}
    "Online": true,
    "ContentType": "{{ metadata.content_type }}",
    "Link": "{{ metadata.path }}",
    "CollectionName": "CLMS",
    "SpatialExtent":"global",
    "ProductType": "{{ metadata.product_type }}",
    "DatasetName": "{{ metadata.dataset_name }}",
    "Version": "{{ metadata.version }}",
    "TargetFormat": "EXTRACTED",
    "DecompressionStep": false,
    "CompresionType": null,
    "ContentDate": {
        "Start": "{{ metadata.content_date.start }}",
        "End": "{{ metadata.content_date.end }}"
    },
    {% if "checksum" in metadata %}
    "Checksum": {
        "Value": "{{ metadata.checksum }}",
        "Algorithm": "MD5",
        "ChecksumDate": "{{ metadata.origin_date }}"
    },
    {% endif %}
    "GeoFootprint": {{ metadata.geometry|tojson }},
    "Attributes": [
        {% for attr in metadata.attributes %}
        {
            "Name": "{{ attr.name }}",
            "ValueType": "{{ attr.value_type }}",
            "Value": {{ attr.value|tojson }}
        }{% if not loop.last %},{% endif +%}
        {% endfor %}
    ]
}